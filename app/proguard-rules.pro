# Правила за R8 (оптимизаторът при сглобяване на release версията).

# Торент двигателят (libtorrent4j): native кодът (C++) вика тези класове и методи по име,
# затова R8 не бива да ги маха или променя.
-keep class org.libtorrent4j.** { *; }
-keep class org.libtorrent4j.swig.libtorrent_jni { *; }

# Имената остават същите: дневникът (Настройки -> Дневник) и следите на сривовете се четат както досега.
# R8 пак маха неизползваното и оптимизира кода.
-dontobfuscate
-keepattributes SourceFile,LineNumberTable

# Незадължителни класове, които библиотеките споменават, но ги няма в приложението:
# slf4j (идва с junrar) търси свой "свързващ" клас; без него просто не пише нищо, както и досега.
-dontwarn org.slf4j.impl.**
# Анотации на jsoup, нужни само при неговото компилиране.
-dontwarn org.jspecify.annotations.**
